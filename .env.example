# ============================================================
# ALEX Environmental Intelligence — Environment Template
# Copy to .env and populate with real credentials.
# Never commit .env to version control.
# ============================================================

# ── 1. AI Models & Reasoning Engines ────────────────────────
GROQ_API_KEY=                        # https://console.groq.com
groq1=                               # groq key rotation slot 1
groq2=                               # groq key rotation slot 2
groq3=                               # groq key rotation slot 3
OPENROUTER_API_KEY=                  # https://openrouter.ai
GEMINI_API_KEY=                      # https://aistudio.google.com

# ── 2. Geospatial, Maps & Satellite ─────────────────────────
MAPS_API_KEY=                        # Google Maps Platform
GOOGLE_MAPS_API_KEY=                 # Alias for MAPS_API_KEY (used by routingService)
FIRMS_API_KEY=                       # https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=                  # Alias for FIRMS_API_KEY
FIRMS_MAP_KEY=                       # Alias for FIRMS_API_KEY
EARTH_ENGINE_PROJECT_ID=             # GEE project ID
EARTH_ENGINE_API_KEY=                # Google Earth Engine API key
COPERNICUS_CLIENT_ID=                # https://dataspace.copernicus.eu
COPERNICUS_CLIENT_SECRET=
OPENSKY_USERNAME=                    # https://opensky-network.org
OPENSKY_PASSWORD=
OPENSKY_CLIENT_ID=                   # OAuth2 client (if using PKCE flow)
OPENSKY_CLIENT_SECRET=
BHOONIDHI_API_KEY=
MARITIME_AIS_KEY=
RAILRADAR_API_KEY=
MAPPLS_ACCESS_TOKEN=
NASA_API_KEY=                        # https://api.nasa.gov

# ── 3. Workspace, Notion & GitHub ───────────────────────────
NOTION_API_KEY=                      # https://www.notion.so/my-integrations
NOTION_DATABASE_ID=
GITHUB_TOKEN=                        # Fine-grained PAT
GITHUB_DEFAULT_OWNER=
GOOGLE_CUSTOM_SEARCH_CX=

# ── 4. Cloud Database & Storage ─────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
JARVIS_SUPABASE_EMAIL=
JARVIS_SUPABASE_PASSWORD=
DATABASE_URL=                        # PostgreSQL connection string (for postgresClient.ts)

# ── 5. Telegram Comms & Executive Identity ──────────────────
TELEGRAM_BOT_TOKEN=                  # From @BotFather
TELEGRAM_CHAT_ID=                    # Destination chat / group ID
TELEGRAM_OWNER_ID=
OWNER_PHONE=
VITE_OWNER_NAME=
VITE_OWNER_PERSONA=
SUDO_PASSWORD=

# ── 6. Twilio Voice Gateway ─────────────────────────────────
TWILIO_ACCOUNT_SID=                  # From Twilio console
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=                    # E.164 format e.g. +14155551234

# ── 7. ALEX Server Configuration ───────────────────────────
SERVER_PORT=3001
ALEX_PUBLIC_URL=http://localhost:3001
ALEX_AUTH_SECRET=                    # JWT signing secret (min 32 chars)
ALEX_OPERATOR_SECRET=                # Elevated-role credential gate

# ── 8. App URL (Vite + Cloud Run) ───────────────────────────
APP_URL=http://localhost:3001
